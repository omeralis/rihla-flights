FROM python:3.12-slim-bookworm
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 CLOAKBROWSER_CACHE_DIR=/opt/cloakbrowser CLOAKBROWSER_VERSION=146.0.7680.177.5 CLOAKBROWSER_AUTO_UPDATE=false
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && python -m playwright install-deps chromium && python -m cloakbrowser install
COPY backend ./backend
COPY dist ./dist
EXPOSE 3000
CMD ["python", "-m", "backend.run"]
