{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "services": {
    "web": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "regions": [
    "fra1"
  ]
}
